{
  "name": "lucid",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "build:firefox": "node build-firefox.mjs",
    "package:firefox": "npm run build:firefox && rm -f lucid.xpi && cd dist-firefox && zip -qr -X ../lucid.xpi ."
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.7",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/markdown-it": "^14.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@mdit/plugin-katex": "^1.1.5",
    "darkreader": "^4.9.134",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3"
  }
}
