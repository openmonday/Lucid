{
  "manifest_version": 3,
  "name": "Lucid",
  "version": "0.1.0",
  "description": "Web translation, Markdown viewing, and automatic dark mode.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://*.bing.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Toggle translation (Alt+A)",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    },
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-translate": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "Toggle bilingual page translation"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "bing",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "options_page": "options.html"
}